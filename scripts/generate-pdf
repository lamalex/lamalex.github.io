#!/usr/bin/env node
/**
 * PDF Generator for Resume and Cover Letter
 * 
 * Usage: 
 *   node generate-pdf.mjs --cv <path.md> --coverletter <path.md>
 *   node generate-pdf.mjs --cv resume.md
 *   node generate-pdf.mjs --coverletter letter.md
 * 
 * Options:
 *   --cv <path>           Path to resume markdown file
 *   --coverletter <path>  Path to cover letter markdown file
 *   -o, --output <dir>    Output directory (default: ./dist)
 *   -h, --help            Show this help message
 */

import { readFile, mkdir } from 'fs/promises';
import { dirname, resolve, basename } from 'path';
import puppeteer from 'puppeteer';
import { marked } from 'marked';

// ATS-friendly CSS for resume
const CV_CSS = `
  @page {
    size: Letter;
    margin: 0.6in 0.7in;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 10.5pt;
    line-height: 1.4;
    color: #000;
    background: #fff;
  }

  h1 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 20pt;
    font-weight: bold;
    margin-bottom: 4pt;
    color: #000;
  }

  /* Subtitle line under name */
  h1 + p {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10pt;
    color: #333;
    margin-bottom: 2pt;
  }

  h2 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12pt;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    border-bottom: 1.5pt solid #000;
    padding-bottom: 3pt;
    margin-top: 14pt;
    margin-bottom: 8pt;
    color: #000;
  }

  h3 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11pt;
    font-weight: bold;
    margin-top: 10pt;
    margin-bottom: 2pt;
    color: #000;
  }

  h4 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10.5pt;
    font-weight: bold;
    margin-top: 8pt;
    margin-bottom: 3pt;
    color: #222;
  }

  p {
    margin-bottom: 6pt;
    text-align: justify;
    hyphens: auto;
  }

  strong {
    font-weight: bold;
  }

  em {
    font-style: italic;
    color: #333;
  }

  ul {
    margin-left: 18pt;
    margin-bottom: 6pt;
  }

  li {
    margin-bottom: 3pt;
    text-align: left;
  }

  hr {
    border: none;
    border-top: 0.5pt solid #ccc;
    margin: 10pt 0;
  }

  /* Contact info line */
  p:first-of-type {
    text-align: center;
  }

  p, li {
    orphans: 2;
    widows: 2;
  }

  h2, h3, h4 {
    page-break-after: avoid;
  }

  h3, h4 {
    page-break-inside: avoid;
  }
`;

// ATS-friendly CSS for cover letter
const COVERLETTER_CSS = `
  @page {
    size: Letter;
    margin: 0.5in 0.75in;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 10.5pt;
    line-height: 1.4;
    color: #000;
    background: #fff;
  }

  h1 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 20pt;
    font-weight: bold;
    margin-bottom: 4pt;
    color: #000;
  }

  /* Contact line under name - centered */
  h1 + p {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10pt;
    color: #333;
    text-align: center;
    margin-bottom: 2pt;
  }

  hr {
    border: none;
    border-top: 0.5pt solid #ccc;
    margin: 10pt 0 20pt 0;
  }

  p {
    margin-bottom: 12pt;
  }

  a {
    color: #000;
    text-decoration: none;
  }

  p {
    orphans: 2;
    widows: 2;
  }
`;

function printHelp() {
  console.log(`
PDF Generator for Resume and Cover Letter

Usage: 
  npm run generate -- --cv <path.md> [--coverletter <path.md>]
  npm run generate -- --coverletter <path.md>

Options:
  --cv <path>           Path to resume markdown file
  --coverletter <path>  Path to cover letter markdown file
  -o, --output <dir>    Output directory (default: ./dist)
  -h, --help            Show this help message

Examples:
  npm run generate -- --cv src/content/cv2.md
  npm run generate -- --coverletter src/content/coverletter2.md
  npm run generate -- --cv resume.md --coverletter letter.md -o ./output
`);
}

function parseArgs(args) {
  const result = {
    cv: null,
    coverletter: null,
    output: './dist',
    help: false,
  };

  for (let i = 0; i < args.length; i++) {
    switch (args[i]) {
      case '--cv':
        result.cv = args[++i];
        break;
      case '--coverletter':
        result.coverletter = args[++i];
        break;
      case '-o':
      case '--output':
        result.output = args[++i];
        break;
      case '-h':
      case '--help':
        result.help = true;
        break;
    }
  }

  return result;
}

async function generatePDF(inputPath, outputPath, css, title) {
  console.log(`Reading markdown from ${inputPath}...`);
  const markdown = await readFile(inputPath, 'utf-8');

  console.log('Converting to HTML...');
  const htmlContent = marked(markdown);

  const html = `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>${title}</title>
  <style>${css}</style>
</head>
<body>
  ${htmlContent}
</body>
</html>
  `;

  console.log('Launching browser...');
  const browser = await puppeteer.launch({
    headless: true,
  });

  const page = await browser.newPage();
  await page.setContent(html, { waitUntil: 'networkidle0' });

  await mkdir(dirname(outputPath), { recursive: true });
  
  console.log('Generating PDF...');
  await page.pdf({
    path: outputPath,
    format: 'Letter',
    printBackground: true,
    preferCSSPageSize: true,
  });

  await browser.close();

  console.log(`PDF generated: ${outputPath}`);
}

async function main() {
  const args = parseArgs(process.argv.slice(2));

  if (args.help) {
    printHelp();
    process.exit(0);
  }

  if (!args.cv && !args.coverletter) {
    console.error('Error: At least one of --cv or --coverletter is required.\n');
    printHelp();
    process.exit(1);
  }

  const outputDir = resolve(args.output);

  if (args.cv) {
    const inputPath = resolve(args.cv);
    const outputName = basename(inputPath, '.md') + '.pdf';
    const outputPath = resolve(outputDir, outputName);
    await generatePDF(inputPath, outputPath, CV_CSS, 'Resume');
  }

  if (args.coverletter) {
    const inputPath = resolve(args.coverletter);
    const outputName = basename(inputPath, '.md') + '.pdf';
    const outputPath = resolve(outputDir, outputName);
    await generatePDF(inputPath, outputPath, COVERLETTER_CSS, 'Cover Letter');
  }
}

main().catch((err) => {
  console.error('Error generating PDF:', err);
  process.exit(1);
});
