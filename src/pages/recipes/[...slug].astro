---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const recipes = await getCollection('recipes');
	return recipes.map((recipe: CollectionEntry<'recipes'>) => ({
		params: { slug: recipe.id },
		props: recipe,
	}));
}

type Props = CollectionEntry<'recipes'>;

const recipe = Astro.props as Props;
const { Content } = await render(recipe);
---

<BlogPost {...recipe.data} backHref="/recipes" backLabel="Recipes">
	<Content />
</BlogPost>
